@startuml architecture-c4
!include ../stdlib/C4_Container.puml

' =====================================================================
'  C4-диаграмма контейнеров. Общая для всех лабораторных работ курса --
'  при добавлении новой лабораторной работы просто дописывайте новый
'  Container(...) внутрь System_Boundary (или новый System_Ext(...) для
'  внешних источников/API) и связи Rel(...), не создавая отдельную
'  диаграмму.
' =====================================================================

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

Person(user, "Пользователь", "Формулирует запросы, управляет коллекциями и разметкой релевантности")

System_Boundary(system, "Информационно-поисковая система (вариант 22)") {
  Container(frontend, "Frontend", "React + Vite + TypeScript", "Коллекции/Документы, Обход, Поиск, Метрики качества")
  Container(api, "API", "Python, FastAPI", "Шлюз и координация сценариев использования")
  Container(nlp, "NLP-service", "Python, FastAPI + nlp_core", "Разбиение текста на слова, TF-IDF, косинусная мера, метрики ROMIP -- углублённый элемент варианта")
  Container(crawler, "Crawler-service", "Python, httpx + BeautifulSoup", "Обход веб-страниц в ширину, извлечение и очистка текста")
  ContainerDb(db, "PostgreSQL", "PostgreSQL + pgvector", "Документы, термы, веса, запросы, выдача, разметка релевантности, метрики")
}

System_Ext(web, "Веб-сайты", "Источники документов в сети Интернет")
System_Ext(openrouter, "OpenRouter", "Внешний поставщик векторных представлений текста (эмбеддингов) для альтернативной модели поиска")

Rel(user, frontend, "Использует", "HTTPS")
Rel(frontend, api, "Вызывает", "REST/JSON")
Rel(api, nlp, "Индексация, вектор запроса, косинусная мера, метрики", "HTTP")
Rel(api, crawler, "Запуск и наблюдение за заданиями на обход", "HTTP")
Rel(api, db, "Читает/пишет", "SQL")
Rel(nlp, db, "Читает/пишет веса терминов", "SQL")
Rel(nlp, openrouter, "Получает векторные представления документов и запросов", "HTTPS")
Rel(crawler, db, "Сохраняет документы и статус заданий", "SQL")
Rel(crawler, web, "Обходит (с учётом robots.txt и ограничения частоты запросов)", "HTTP")

@enduml
