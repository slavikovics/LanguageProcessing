@startuml architecture-c4
!include ../stdlib/C4_Container.puml

' =====================================================================
'  C4-диаграмма контейнеров. Общая для всех лабораторных работ курса --
'  при добавлении новой лабораторной работы просто дописывайте новый
'  Container(...) внутрь System_Boundary (или новый System_Ext(...) для
'  внешних источников/API) и связи Rel(...), не создавая отдельную
'  диаграмму. Компоненты и связи, добавленные в ЛР2 (определение языка
'  текста), помечены тегом "new" -- зелёная заливка -- и вынесены
'  отдельным пунктом в легенде.
' =====================================================================

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

AddElementTag("new", $bgColor="#2e7d32", $fontColor="#ffffff", $borderColor="#1b5e20", $legendText="добавлено в ЛР2")
AddRelTag("new", $textColor="#2e7d32", $lineColor="#2e7d32", $legendText="добавлено в ЛР2")

Person(user, "Пользователь", "Формулирует запросы, управляет коллекциями, размечает релевантность и истинный язык документов")

System_Boundary(system, "Информационно-поисковая система (вариант 22 / вариант 25)") {
  Container(frontend, "Frontend", "React + Vite + TypeScript", "Коллекции/Документы, Обход, Поиск, Метрики качества, Определение языка (ЛР2)")
  Container(api, "API", "Python, FastAPI", "Шлюз и координация сценариев использования, в т.ч. разметка/профили/тестирование определения языка (ЛР2)")
  Container(nlp, "NLP-service", "Python, FastAPI + nlp_core", "Разбиение текста на слова, TF-IDF, косинусная мера, метрики ROMIP, извлечение основного содержимого страницы")
  Container(crawler, "Crawler-service", "Python, httpx + BeautifulSoup", "Обход веб-страниц в ширину, извлечение и очистка текста; язык обхода задаётся per-seed (ЛР2)")
  Container(langid, "Lang-ID-service", "Python, FastAPI + PyTorch", "Методы частотных слов, алфавитный и нейросетевой (линейный классификатор над эмбеддингами) -- углублённый элемент ЛР2", $tags="new")
  ContainerDb(db, "PostgreSQL", "PostgreSQL + pgvector", "Документы, термы, веса, запросы, выдача, разметка релевантности и языка, профили и результаты определения языка (ЛР2)")
}

System_Ext(web, "Веб-сайты", "Источники документов в сети Интернет (в т.ч. англо- и франкоязычная Wikipedia)")
System_Ext(openrouter, "OpenRouter", "Внешний поставщик векторных представлений текста (эмбеддингов) для модели поиска и для нейросетевого метода определения языка")

Rel(user, frontend, "Использует", "HTTPS")
Rel(frontend, api, "Вызывает", "REST/JSON")
Rel(api, nlp, "Индексация, вектор запроса, косинусная мера, метрики, извлечение содержимого страницы, эмбеддинг текста для нейросетевого метода ЛР2", "HTTP")
Rel(api, crawler, "Запуск и наблюдение за заданиями на обход", "HTTP")
Rel(api, db, "Читает/пишет", "SQL")
Rel(nlp, db, "Читает/пишет веса терминов", "SQL")
Rel(nlp, openrouter, "Получает векторные представления документов и запросов", "HTTPS")
Rel(crawler, db, "Сохраняет документы (с языком seed'а) и статус заданий", "SQL")
Rel(crawler, web, "Обходит (с учётом robots.txt и ограничения частоты запросов)", "HTTP")
Rel(api, langid, "Строит профили языков, определяет язык документа/текста (передавая эмбеддинг, полученный от nlp-service), обучает нейросетевой классификатор", "HTTP", $tags="new")

@enduml
