@startuml command-matching

' =====================================================================
'  Сопоставление фразы с командой (match_command в
'  services/api/app/domain/speech.py и matchCommand.ts).
' =====================================================================

start
:Вход: распознанный текст, список команд;
:Нормализация текста: знаки препинания -> пробелы,\nсхлопывание пробелов, нижний регистр, trim;
if (нормализованный текст пуст?) then (да)
  :Вернуть "команда не найдена";
  stop
endif
while (есть непроверенная команда?) is (да)
  if (команда неактивна?) then (да)
    :Пропустить;
  else (нет)
    :p = нормализованная фраза команды;
    if (p является подстрокой текста?) then (да)
      :Вернуть эту команду\n(первую по порядку id);
      stop
    endif
  endif
endwhile (нет)
:Вернуть "команда не найдена";
stop

@enduml
