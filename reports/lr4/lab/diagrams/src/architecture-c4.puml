@startuml architecture-c4
!include ../stdlib/C4_Container.puml

' =====================================================================
'  C4-диаграмма контейнеров. Общая для всех лабораторных работ курса --
'  при добавлении новой лабораторной работы просто дописывайте новый
'  Container(...) внутрь System_Boundary (или новый System_Ext(...) для
'  внешних источников/API) и связи Rel(...), не создавая отдельную
'  диаграмму. Компоненты и связи, добавленные в ЛР4 (машинный перевод
'  текстов), помечены тегом "new" -- зелёная заливка -- и вынесены
'  отдельным пунктом в легенде. В отличие от ЛР2/ЛР3, для перевода не
'  понадобился отдельный микросервис: словарь -- это просто ещё одна
'  таблица БД, к которой уже умеет обращаться api, а сам перевод и
'  синтаксический разбор -- новые чистые (без состояния) операции над
'  spaCy, естественно ложащиеся в nlp-service рядом с токенизацией.
' =====================================================================

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

AddElementTag("new", $bgColor="#2e7d32", $fontColor="#ffffff", $borderColor="#1b5e20", $legendText="добавлено в ЛР4")
AddRelTag("new", $textColor="#2e7d32", $lineColor="#2e7d32", $legendText="добавлено в ЛР4")

Person(user, "Пользователь", "Формулирует запросы, управляет коллекциями, размечает релевантность и истинный язык документов")

System_Boundary(system, "Информационно-поисковая система (вариант 22 / вариант 25 / вариант 16 / вариант 11)") {
  Container(frontend, "Frontend", "React + Vite + TypeScript", "Коллекции/Документы, Обход, Поиск, Метрики качества, Определение языка, Реферирование, Машинный перевод (ЛР4)")
  Container(api, "API", "Python, FastAPI", "Шлюз и координация сценариев использования, в т.ч. прямой перевод текста, CRUD словаря переводов и разбор предложения (ЛР4)")
  Container(nlp, "NLP-service", "Python, FastAPI + nlp_core", "Разбиение текста на слова и предложения, TF-IDF, косинусная мера, метрики ROMIP, извлечение основного содержимого страницы, перефразирование через LLM, пословный перевод по словарю и синтаксический разбор предложения (ЛР4)")
  Container(crawler, "Crawler-service", "Python, httpx + BeautifulSoup", "Обход веб-страниц в ширину, извлечение и очистка текста; язык обхода задаётся per-seed")
  Container(langid, "Lang-ID-service", "Python, FastAPI + PyTorch", "Методы частотных слов, алфавитный и нейросетевой (линейный классификатор над эмбеддингами)")
  Container(summarization, "Summarization-service", "Python, FastAPI + nlp_core", "Отбор предложений тремя методами (алгоритмический, TextRank, эмбеддинги) и построение иерархического реферата-списка ключевых слов")
  ContainerDb(db, "PostgreSQL", "PostgreSQL + pgvector", "Документы, термы, веса, запросы, выдача, разметка релевантности и языка, профили определения языка, рефераты, словарь переводов, история переводов и тестовые прогоны перевода (ЛР4)")
}

System_Ext(web, "Веб-сайты", "Источники документов в сети Интернет (в т.ч. англо- и франкоязычная Wikipedia)")
System_Ext(openrouter, "OpenRouter", "Внешний поставщик векторных представлений текста (эмбеддингов) и LLM-модели перефразирования")

Rel(user, frontend, "Использует", "HTTPS")
Rel(frontend, api, "Вызывает", "REST/JSON")
Rel(api, nlp, "Индексация, вектор запроса, косинусная мера, метрики, извлечение содержимого страницы, эмбеддинг текста, сплит на предложения, перефразирование, пословный перевод и синтаксический разбор (ЛР4)", "HTTP")
Rel(api, crawler, "Запуск и наблюдение за заданиями на обход", "HTTP")
Rel(api, db, "Читает/пишет, в т.ч. словарь переводов и историю прогонов перевода (ЛР4)", "SQL", $tags="new")
Rel(nlp, db, "Читает/пишет веса терминов", "SQL")
Rel(nlp, openrouter, "Получает векторные представления текста и перефразированный LLM-моделью текст", "HTTPS")
Rel(crawler, db, "Сохраняет документы (с языком seed'а) и статус заданий", "SQL")
Rel(crawler, web, "Обходит (с учётом robots.txt и ограничения частоты запросов)", "HTTP")
Rel(api, langid, "Строит профили языков, определяет язык документа/текста, обучает нейросетевой классификатор", "HTTP")
Rel(api, summarization, "Строит реферат (алгоритм/TextRank/эмбеддинги) и иерархический список ключевых слов", "HTTP")

@enduml
