@startuml translation-pipeline

' =====================================================================
'  Прямой (пословный) перевод одного текста -- единая схема для основного
'  перевода (вкладка "Перевод") и частотного словаря (вкладка 1);
'  дерево синтаксического разбора (вкладка 2) -- отдельный, не зависящий
'  от перевода запрос по выбранному предложению (см. правую ветвь).
' =====================================================================

start
:Вход: текст на входном языке\n(документ коллекции либо вставленный текст);

:Шаг 1. Загрузка словаря переводов\nиз БД (translation_dictionary_entries)\nдля пары языков en -> fr;
:Построение lookup-словаря\n{"лемма|POS": перевод}\n+ откат {"лемма|*": перевод}\nдля каждой леммы (nlp-service);

:Шаг 2. Токенизация всего текста (spaCy, nlp_core.translation)\nдля каждого токена: лемма, POS-тег, is_stop, whitespace_;

if (токен -- слово (is_alpha)?) then (да)
  :Поиск перевода: сначала (лемма, POS),\nпри отсутствии -- (лемма, *);
  if (перевод найден?) then (да)
    :Подстановка перевода\nс сохранением регистра исходного слова;
  else (нет)
    :Слово остаётся непереведённым\n(оставляется как есть);
  endif
else (нет -- пунктуация/пробел)
  :Токен копируется без изменений;
endif

:Шаг 3. Сборка переведённого текста\n(join токенов с исходными пробелами);
:Подсчёт: слов во входном тексте,\nпереведено слов (нашли перевод);

:Шаг 4. Частотный словарь (вкладка 1):\nлеммы текста без стоп-слов,\nсгруппированные по (лемма, POS),\nотсортированные по убыванию частоты,\nкаждая -- с переводом (тот же словарь);

:Сохранение результата (TranslationRun +\nTranslationRunWord) в БД;
stop

@enduml
