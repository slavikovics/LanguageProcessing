@startuml summarization-pipeline

' =====================================================================
'  Построение реферата одного документа -- общая схема для всех трёх
'  реализованных методов отбора предложений (позиционно-частотный
'  метод, TextRank, эмбеддинги), различающихся только правилом расчёта веса
'  предложения (шаг 2). Реферат-список ключевых слов (шаг 4) строится
'  один раз, единообразно для всех методов -- он не зависит от способа
'  отбора предложений.
' =====================================================================

start
:Шаг 1. Разбиение документа на предложения\n(spaCy sentencizer, nlp_core);

switch (Шаг 2. Метод отбора предложений?)
case (позиционно-частотный метод)
  :Вес(Si) = Posd(Si) * Posp(Si) * Score(Si);
  :Posd/Posp -- положение предложения\nв документе/абзаце (1 - смещение/длина);
  :Score(Si) = сумма модифицированного TF-IDF\nвеса терминов предложения;
case (TextRank)
  :Граф: предложения -- вершины,\nвес ребра -- пересечение лемм,\nнормированное по log длины предложений;
  :Вес(Si) = PageRank по этому графу\n(damping = 0.85, до сходимости);
case (эмбеддинги)
  :Каждое предложение кодируется\nмоделью OpenRouter (nlp-service);
  if (задан запрос пользователя?) then (нет)
    :Вес(Si) = косинусная близость\nэмбеддинга Si к центроиду\nэмбеддингов всех предложений документа;
  else (да)
    :Запрос кодируется той же моделью;
    :Вес(Si) = косинусная близость\nэмбеддинга Si к эмбеддингу запроса;
  endif
endswitch

:Шаг 3. Отбор N предложений с наибольшим весом,\nвозврат к исходному порядку следования в документе;
:Сохранение реферата (DocumentSummary):\nтекст, индексы предложений, затраченное время,\nдлина документа (total_chars);
:Степень сжатия вычисляется при отображении\n(длина реферата / total_chars), в БД не хранится;

:Шаг 4. Реферат-список ключевых слов (не зависит от метода):\nкорни -- термины документа с наибольшим весом (TF-IDF);\nсловосочетания -- смежные прилагательные/существительные текста,\nсгруппированные под корневым словом, которое они содержат;

:Шаг 5 (опционально). Перефразирование отобранных предложений\nчерез LLM (OpenRouter, nlp-service) -- без добавления новых фактов;
stop

@enduml
