POSTGRES_USER=ips_user
POSTGRES_PASSWORD=ips_password
POSTGRES_DB=ips
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port for `docker compose` to publish Postgres on (container-to-container
# traffic always uses 5432 regardless of this value) — change if 5433 is also taken.
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+asyncpg://ips_user:ips_password@postgres:5432/ips

NLP_SERVICE_URL=http://nlp-service:8001
API_URL=http://api:8000

CRAWLER_USER_AGENT=IPSLabBot/0.1 (+educational project)
CRAWLER_POLITENESS_DELAY_SECONDS=1.0

VITE_API_BASE_URL=http://localhost:8000
